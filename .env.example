# Base URL of the Wedding Project Golang REST API (including the /api/v1 prefix).
# Local default when talking to the backend directly:
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Recommended for local development: leave VITE_API_BASE_URL empty (or set it to /api/v1)
# and let the Vite dev server proxy /api to the backend so the session cookie stays same-origin.
# VITE_API_BASE_URL=/api/v1
# VITE_DEV_PROXY_TARGET=http://localhost:8080

# Development-only in-memory mock API for visual work when the backend is not running.
# Ignored in production builds. Prefer `npm run dev:mock` (uses .env.mock).
# VITE_USE_MOCKS=false
