# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo
.vite/

# Tests & coverage
coverage/
.vitest/

# Environment files: real values never get committed.
# .env.example (template) and .env.mock (mock-mode flags, no secrets) stay tracked.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors & IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Misc
*.tgz
.cache/
.eslintcache
.stylelintcache
